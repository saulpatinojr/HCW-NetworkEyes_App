// CNA Platform — Prisma schema
// PostgreSQL 16 via Azure Flexible Server (private, VNet-integrated)
// Run:  npx prisma db push   (dev)
//       npx prisma migrate deploy   (prod/CI)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(ANALYST)
  // Break-glass local admin account (not tied to Entra ID SSO). passwordHash
  // is a PBKDF2-HMAC-SHA256 hash (see lib/local-admin.ts), never plaintext.
  // Only the single row seeded by prisma/seed-local-admin.ts has these set;
  // Entra-provisioned users never get a passwordHash.
  passwordHash  String?
  isLocalAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  engagements   EngagementMember[]
}

enum UserRole {
  ANALYST   // Can run discovery, create engagements, run analysis
  REVIEWER  // Can approve findings and publish deliverables
  CLIENT    // Read-only: can view published deliverables for their org
  ADMIN     // Full platform access
}

// NextAuth.js required tables ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Global App Settings ─────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Engagements ──────────────────────────────────────────────────────────────

model Engagement {
  id          String           @id @default(cuid())
  name        String
  clientOrg   String
  status      EngagementStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members            EngagementMember[]
  documents          IngestedDocument[]
  findings           Finding[]
  deliverables       Deliverable[]
  cloudCredentials   CloudCredential[]
  discoveryJobs      DiscoveryJob[]
  metricRecords      MetricRecord[]
  portalPublications PortalPublication[]
}

enum EngagementStatus {
  DRAFT
  DISCOVERY
  ANALYSIS
  REVIEW
  DELIVERED
}

model EngagementMember {
  id           String     @id @default(cuid())
  engagementId String
  userId       String
  role         UserRole

  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([engagementId, userId])
}

// ─── Document Ingestion ───────────────────────────────────────────────────────

model IngestedDocument {
  id           String       @id @default(cuid())
  engagementId String
  fileName     String
  blobPath     String       // path in Azure Blob Storage engagements/ container
  docType      DocumentType
  parsedText   String?      @db.Text
  vectorId     String?      // future: Azure AI Search vector index reference
  createdAt    DateTime     @default(now())

  engagement   Engagement   @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  findings     Finding[]

  @@index([engagementId])
}

enum DocumentType {
  CLIENT_ARCHITECTURE
  COMPLIANCE_FRAMEWORK
  NETWORK_DIAGRAM
  CONFIGURATION_EXPORT
  OTHER
}

// ─── Analysis & Findings ──────────────────────────────────────────────────────

model Finding {
  id           String         @id @default(cuid())
  engagementId String
  documentId   String?
  credentialId String?          // discovery source: which subscription generated this finding
  title        String
  severity     FindingSeverity
  category     String
  description  String         @db.Text
  recommendation String?      @db.Text
  aiGenerated  Boolean        @default(true)
  trafficDirection String?    // east_west | north_south | management (finding taxonomy)
  region       String?
  resourceType String?
  estCostImpact Float?        // estimated monthly cost impact (USD) — [VERIFY] estimate
  reviewedBy   String?        // userId of reviewer
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  engagement   Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  document     IngestedDocument? @relation(fields: [documentId], references: [id])
  credential   CloudCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([engagementId])
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

// ─── Cloud Discovery ──────────────────────────────────────────────────────────

enum CloudPlatform {
  AZURE
  AWS
}

enum DiscoveryJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model CloudCredential {
  id           String        @id @default(cuid())
  engagementId String
  platform     CloudPlatform
  label        String        // human-readable e.g. "ACME Corp Production"

  // Azure
  tenantId        String?
  subscriptionIds String[]   // empty = all accessible subscriptions
  spClientId      String?    // service principal client ID
  spSecretEnc     String?    @db.Text // AES-256-GCM encrypted client secret

  // AWS
  awsRoleArn      String?
  awsExternalId   String?
  awsRegions      String[]
  awsAccessKeyId  String?
  awsSecretEnc    String?  @db.Text // AES-256-GCM encrypted secret access key

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  engagement         Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  jobs               DiscoveryJob[]
  discoveryFindings  Finding[]

  @@unique([engagementId, label])
}

model DiscoveryJob {
  id            String             @id @default(cuid())
  engagementId  String
  credentialId  String?            // nullable: SET NULL when credential is removed
  status        DiscoveryJobStatus @default(QUEUED)
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?            @db.Text
  findingsCount Int?
  progressLog   String?            @db.Text // JSON array of status messages
  topologyJson  String?            @db.Text // Full AzureTopology JSON for inventory page
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  engagement    Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  credential    CloudCredential?   @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([engagementId])
}

// ─── Stat Masters (Phase C) ───────────────────────────────────────────────────
// Pre-aggregated fact rows built by cna/core/stat_masters.py via the cna-api
// metrics router. One row per unique dimension tuple per engagement.

model MetricRecord {
  id           String   @id @default(cuid())
  engagementId String

  // Dimensions (nullable — "" / fallback labels normalized by the API)
  trafficDirection String?
  severity         String?
  framework        String?
  region           String?
  subscriptionId   String?
  resourceType     String?
  category         String?
  ruleId           String?

  // Measures
  findingCount         Int   @default(0)
  resourceCount        Int   @default(0)
  estMonthlyCostImpact Float @default(0) // USD — static-price [VERIFY] estimate

  createdAt DateTime @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
}

// ─── Deliverables ─────────────────────────────────────────────────────────────

model Deliverable {
  id              String            @id @default(cuid())
  engagementId    String
  title           String
  type            DeliverableType
  blobPath        String?           // path to generated file in Blob Storage
  content         String?           @db.Text // inline markdown for previews
  // Sectioned Comprehensive Assessment runs in the background (multi-pass AI
  // generation exceeds edge timeouts); status + progressLog drive the polling UI.
  status          DeliverableStatus @default(COMPLETED)
  progressLog     String?           @db.Text // JSON array of {stepId,label,status}
  publishedAt     DateTime?
  publishedBy     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  engagement      Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
}

enum DeliverableStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// One row per client-portal publication (CNA-0.90 §3: the publish story).
// Metadata only — the SAS portal URL is never stored (AccessManager's
// contract); the API returns it once and the operator shares it.
model PortalPublication {
  id               String   @id @default(cuid())
  engagementId     String
  cloud            String   @default("azure")
  storageLocation  String
  deliverableCount Int
  ttlHours         Int
  issuedAt         DateTime
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
}

enum DeliverableType {
  SPECIALIZATION_REPORT
  EXECUTIVE_SUMMARY
  TECHNICAL_FINDINGS
  REMEDIATION_PLAN
  COMPREHENSIVE_ASSESSMENT
  INTERACTIVE_ASSESSMENT
  ENCYCLOPEDIA_CONDENSED
  ENCYCLOPEDIA_EXPANDED
}
