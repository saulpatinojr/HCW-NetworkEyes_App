# CNA Web — environment variable reference
# Copy to .env.local for local development. Never commit .env.local.
# In Azure, these are injected from Container App secrets (sensitive)
# or plain env vars (non-sensitive) defined in Terraform.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local: use a local PostgreSQL instance or Docker
DATABASE_URL="postgresql://cnaadmin:devpassword@localhost:5432/cna?sslmode=disable"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ─── Entra ID (Azure AD) ──────────────────────────────────────────────────────
# Create an App Registration in Entra ID:
#   Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
#   Required scopes: openid, profile, email, User.Read
AZURE_AD_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_AD_CLIENT_SECRET="your-entra-client-secret"
AZURE_AD_TENANT_ID="00000000-0000-0000-0000-000000000000"

# ─── Internal API (cna-api) ───────────────────────────────────────────────────
# In Azure, cna-api is internal. cna-web calls it over the private ACA DNS.
# Locally, run cna-api on port 8000.
CNA_API_INTERNAL_URL="http://localhost:8000"

# ─── Azure Monitoring ─────────────────────────────────────────────────────────
# Set in Azure — injected as plain env var by Terraform
APPLICATIONINSIGHTS_CONNECTION_STRING=""
