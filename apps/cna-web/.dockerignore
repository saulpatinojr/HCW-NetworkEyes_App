# Build context fence for the web/migrator images (IMG-007). Keeps host-only and
# non-runtime content out of the image build context. node_modules is
# re-installed cleanly in the deps stage via `npm ci`, so the host copy must not
# leak in and shadow it.
node_modules
**/node_modules

# Next.js build output — regenerated by `npm run build` in the builder stage.
.next
out

# Never ship secrets into the build context.
.env
.env.*

# Docs are not runtime artifacts.
*.md

# Tests and test fixtures are not needed at build/runtime.
**/*.test.ts
**/*.test.tsx
**/__tests__

# Local tooling / VCS noise.
.git
.gitignore
.vscode
.idea
*.log
