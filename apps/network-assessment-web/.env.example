# NetworkEyes web app — environment variable reference
# Copy to .env.local for local development. Never commit .env.local.
# In Azure, these are injected from Container App secrets (sensitive)
# or plain env vars (non-sensitive) defined in Terraform.
#
# Setting names are NETWORK_ASSESSMENT_<NAME>. An image built from this change also reads the old CNA_<NAME> names when
# the new name has no value (a new name that has a value wins; a blank one does not hide an old one). That fallback will
# be removed in a later release, so rename the settings in your deployment. It works one way only: an older image reads
# only the old names, so while old and new images run side by side, and when rolling back, set BOTH names to the same value.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local: use a local PostgreSQL instance or Docker
DATABASE_URL="postgresql://cnaadmin:devpassword@localhost:5432/cna?sslmode=disable"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ─── Entra ID (Azure AD) ──────────────────────────────────────────────────────
# Create an App Registration in Entra ID:
#   Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
#   Required scopes: openid, profile, email, User.Read
AZURE_AD_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_AD_CLIENT_SECRET="your-entra-client-secret"
AZURE_AD_TENANT_ID="00000000-0000-0000-0000-000000000000"

# ─── Internal API (network-assessment-api) ───────────────────────────────────────────────────
# In Azure, network-assessment-api is internal. network-assessment-web calls it over the private ACA DNS.
# Locally, run network-assessment-api on port 8000.
NETWORK_ASSESSMENT_API_INTERNAL_URL="http://localhost:8000"

# ─── Azure Monitoring ─────────────────────────────────────────────────────────
# Set in Azure — injected as plain env var by Terraform
APPLICATIONINSIGHTS_CONNECTION_STRING=""
