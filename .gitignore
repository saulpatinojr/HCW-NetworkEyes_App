# setuptools build output (a local `pip install --no-build-isolation .` leaves it behind)
build/
dist/
apps/cna-web/tsconfig.tsbuildinfo

# Operational logs and payloads — contain runtime data, not source
*.log
payload*.json

# Terraform plan files — contain sensitive variable values
*.tfplan
tfplan

# Terraform security scan output — generated artifact, not source
checkov_results.txt

# Local pip junk from broken system Python (used as local test env)
/Lib/
apps/cna-web/lib/site-packages/
apps/cna-web/scripts/*.exe
scripts/*.exe
PACS/
