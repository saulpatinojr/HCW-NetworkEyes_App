# NetworkEyes — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# Each variable is explained by the comment next to it.
#
# Setting names are NETWORK_ASSESSMENT_<NAME>. An image built from this change also reads the old CNA_<NAME> names when
# the new name has no value (a new name that has a value wins; a blank one does not hide an old one). That fallback will
# be removed in a later release, so rename the settings in your deployment. It works one way only: an older image reads
# only the old names, so while old and new images run side by side, and when rolling back, set BOTH names to the same value.
#
# TIP: read the populated values from your cloud vault (Key Vault or Secrets Manager)
# into a local .env; this repository ships none.
#
# Single-cloud usage: only fill the section for your target cloud.
# Both sections only needed for dual-cloud engagements.

# =============================================================================
# GITHUB ACTIONS — SECRETS  (GitHub Settings → Secrets and variables → Actions)
# These are NOT set in .env. Documented here so the secrets checklist is in
# one place.
# They are the names a deployment keeps in its own pipeline; this repository holds none of them.
# =============================================================================
#
# Secret name                                  | Description
# ---------------------------------------------|-----------------------------------------------
# AZURE_CLIENT_ID                              | OIDC app registration Client ID
# AZURE_TENANT_ID                              | Azure AD tenant GUID
# AZURE_SUBSCRIPTION_ID                        | Azure subscription ID
# DOCKERHUB_USERNAME                           | Docker Hub username or namespace-authorized user
# DOCKERHUB_TOKEN                              | Docker Hub access token (the OIDC login does not use it; the image repository is public)
# NETWORK_ASSESSMENT_POSTGRES_ADMIN_PASSWORD   | PostgreSQL admin password (min 8 chars)
# NETWORK_ASSESSMENT_ENTRA_CLIENT_SECRET       | Entra ID OAuth2 client secret (NextAuth)
# NETWORK_ASSESSMENT_NEXTAUTH_SECRET           | NextAuth JWT signing secret (openssl rand -base64 32)
# NETWORK_ASSESSMENT_CREDENTIAL_ENCRYPTION_KEY | Base64 32-byte key for stored cloud credentials
# FRONTDOOR_CERTIFICATE_PFX_PASSWORD           | Password for custom TLS cert (optional)
# NETWORK_ASSESSMENT_AWS_ROLE_ARN              | ARN of CNA-Publish IAM role (OIDC)
# NETWORK_ASSESSMENT_PUBLISH_BUCKET            | S3 bucket name for the AWS delivery portal

# =============================================================================
# GITHUB ACTIONS — VARIABLES  (GitHub Settings → Secrets and variables → Variables)
# Non-sensitive identifiers a deployment typically keeps as variables in its own repository
# or pipeline; this repository's workflows read none of them
# =============================================================================
#
# Variable name                          | Example value
# ---------------------------------------|-----------------------------------------------
# TFSTATE_RESOURCE_GROUP                 | rg-cna-tfstate
# TFSTATE_STORAGE_ACCOUNT                | stcna<name>tfstate
# TFSTATE_CONTAINER                      | tfstate
# NETWORK_ASSESSMENT_ENTRA_CLIENT_ID     | 00000000-0000-0000-0000-000000000000
# NETWORK_ASSESSMENT_NEXTAUTH_URL        | https://<frontdoor_endpoint_host_name>
# NETWORK_ASSESSMENT_AI_ENGINE_DEFAULT   | azure-openai
# NETWORK_ASSESSMENT_AZURE_MCP_ENDPOINT  | none
# NETWORK_ASSESSMENT_AZURE_MCP_TRANSPORT | sse
# NETWORK_ASSESSMENT_AWS_MCP_ENDPOINT    | none
# NETWORK_ASSESSMENT_AWS_MCP_TRANSPORT   | stdio
# NETWORK_ASSESSMENT_DRAWIO_MCP_URL      | none
# APPLICATION_INSIGHTS_NAME              | none
# KEY_VAULT_NAME                         | none
# FRONTDOOR_CERTIFICATE_NAME             | networkeyes-cert  (Key Vault cert name)
# FRONTDOOR_CERTIFICATE_PFX_PATH         | certs/networkeyes.pfx  (repo-relative path)

# =============================================================================
# AZURE IDENTITY — Local dev overrides
# =============================================================================
# Used by: network-assessment discover azure, network-assessment analyze --azure, network-assessment publish --cloud azure
# Auth method: DefaultAzureCredential chain
#   Priority: env vars below → az login → managed identity (in CI/CD)
# Leave AZURE_CLIENT_ID blank when using `az login` locally. There is no client secret:
# the appliance runs as its user-assigned managed identity and refuses to start when
# AZURE_CLIENT_SECRET, AZURE_CLIENT_CERTIFICATE_PATH, AZURE_USERNAME, AZURE_PASSWORD,
# AZURE_FEDERATED_TOKEN_FILE or AZURE_AUTHORITY_HOST is set (REFACTOR_APP.md change set G).
AZURE_TENANT_ID=                          # Azure AD tenant GUID
AZURE_CLIENT_ID=                          # App registration or managed identity client ID

# =============================================================================
# AZURE DISCOVERY
# =============================================================================
# Used by: network-assessment discover azure
# No extra vars needed beyond AZURE_TENANT_ID above.
# Required RBAC: Reader on each assessed scope; optional Security Reader, Cost Management
# Reader, Log Analytics Reader, CNA Network BGP Reader (docs/roles/cna-network-bgp-reader.json,
# its actions checked against Microsoft Learn on 2026-10-25) and Management Group Reader for
# the management-group tree.
# Never a write role: the scan is read-only (REFACTOR_APP.md change set F).
# Dynamic region enumeration: handled by DefaultAzureCredential + ARM API (DD-006).
#
# AWS (optional, REFACTOR_APP.md change set K): `pip install ".[aws]"` (from a checkout of this repository; it is not published on PyPI) installs boto3 and
# enables `network-assessment discover aws`, Security Hub, the S3 delivery portal, Bedrock chat and the
# /discovery/*-aws API routes. Without it those routes answer 501 aws_not_installed and the
# AWS modules raise ImportError naming the extra. Permissions: network_assessment/modules/network/module.aws.yaml.
# Discovery backend (REFACTOR_APP.md change set D): one paged Resource Graph query set per
# scope builds the model; ARM is used only for BGP, metrics, diagnostics, cost and Log
# Analytics. `arm` keeps the per-subscription list loop for one release.
NETWORK_ASSESSMENT_DISCOVERY_BACKEND=resource-graph      # resource-graph | arm
# Scopes to assess, space-separated: /subscriptions/<id> or /subscriptions/<id>/resourceGroups/<name>.
# Blank = the --subscriptions given, else every subscription the identity can list.
NETWORK_ASSESSMENT_SCOPES=

# =============================================================================
# AZURE DELIVERY PORTAL
# =============================================================================
# Used by: network-assessment publish --cloud azure
# Storage account provisioned by whoever deploys the images (Terraform or another tool) (storage module).
# DefaultAzureCredential handles auth — no key needed in managed identity environments.
AZURE_STORAGE_ACCOUNT_NAME=               # e.g. stcnadeliveriesdeveus  (Terraform output)
AZURE_STORAGE_CONTAINER_ENGAGEMENTS=engagements

# =============================================================================
# AZURE OPENAI (primary GenAI provider)
# =============================================================================
# Provisioned by whoever deploys the images (Terraform or another tool) on the AIServices/Foundry account: the model
# deployment, a private endpoint into the CNA VNet, RBAC for the app's managed
# identity, and these env vars. Auth is managed identity (DefaultAzureCredential)
# — local auth is disabled on the account, so there is NO API-key fallback.
AZURE_OPENAI_ENDPOINT=                     # e.g. https://<account>.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-chat-latest
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# =============================================================================
# GENAI ENGINE MODE + SWITCHING
# =============================================================================
# Used by: network-assessment-web (analysis, deliverables, admin AI Engine page) and network-assessment-api (chat).
# All three are injected by whoever deploys the images (this repository has no deploy workflow).
#
# NETWORK_ASSESSMENT_AI_MODE selects the engine family:
#   saas     — cloud-native engine for this deployment (Foundry/Azure OpenAI on
#              Azure, Bedrock on AWS); Terraform provisions it, auth is the
#              managed identity / task role.
#   byo-api  — bring-your-own provider (Anthropic Claude and/or OpenAI) for
#              locations where Foundry/Bedrock are unavailable. NO cloud AI
#              resources are provisioned. The API keys are the ONLY secrets an
#              admin enters in the app UI (/admin/ai-engine); they are stored
#              AES-256-GCM encrypted in Postgres (CREDENTIAL_ENCRYPTION_KEY) and
#              are never set in env, workflow inputs, or Terraform.
NETWORK_ASSESSMENT_AI_MODE=saas
NETWORK_ASSESSMENT_APPLIANCE_CLOUD=azure                 # azure | aws — which SaaS engine applies. Set = appliance mode: the API refuses to start without DATABASE_URL and NETWORK_ASSESSMENT_API_TOKEN

# Shared bearer secret for internal web→api calls. The deployment
# generates it, stores it in the cloud vault, and injects it into BOTH the api
# and the web containers. When set, the API rejects any request lacking
# `Authorization: Bearer <NETWORK_ASSESSMENT_API_TOKEN>` (except /health and /ready). Leave
# blank for local dev (unauthenticated, with a startup warning).
# The web route /api/drawio-mcp/* also requires it (ticket #245): the Python draw.io client sends it
# as a bearer, so set the same value for the web app and the Python process to use that route.
NETWORK_ASSESSMENT_API_TOKEN=                            # Set by the deployment (container secret); blank locally
# Entra bearer validation on the internal routes (/discovery/*, /intake, /publish):
# the web tier's managed identity presents a token for this API's app registration
# and must hold the app role below. Set the tenant and audience together or not at
# all; the JWKS URL is derived from the tenant. In appliance mode at least one of
# NETWORK_ASSESSMENT_API_TOKEN or this pair is required, and NETWORK_ASSESSMENT_PROFILE is refused outright.
NETWORK_ASSESSMENT_ENTRA_TENANT_ID=                      # Set by the deployment; blank locally
NETWORK_ASSESSMENT_ENTRA_AUDIENCE=                       # api://<app-registration identifier URI>; set by the deployment
NETWORK_ASSESSMENT_ENTRA_JWKS_URL=                       # Optional override; derived from the tenant when blank
NETWORK_ASSESSMENT_ENTRA_REQUIRED_ROLE=Discovery.Run     # App role (roles) or delegated scope (scp) the token must carry
# Minutes a discovery job may go without a progress heartbeat before the API
# reaps it to FAILED (REL-001). Optional; defaults to 30.
NETWORK_ASSESSMENT_STALE_JOB_MINUTES=30
# network-assessment-api database connection pool (T-704). Optional: the most connections the
# API process keeps open to Postgres, and how long a request waits for a free
# one before answering 503. Defaults 10 and 10.
NETWORK_ASSESSMENT_DB_POOL_MAX=10
NETWORK_ASSESSMENT_DB_POOL_TIMEOUT_SECONDS=10
# Active engine is stored in Postgres setting ai.activeEngine. In byo-api mode
# with BOTH keys present this default breaks the tie when no setting exists;
# with one key that provider is active regardless.
#   saas/azure => azure-openai   saas/aws => bedrock   byo-api => anthropic | openai
NETWORK_ASSESSMENT_AI_ENGINE_DEFAULT=azure-openai
# Optional BYO model overrides (AppSetting ai.byo.<provider>.model wins over these).
# Defaults in code: claude-opus-5 / gpt-5.4. Checked 2026-10-25: both ids are still available
# (Anthropic lists claude-opus-5 as a legacy model that is still available, the current Opus is
# claude-opus-5-5; OpenAI's model and deprecation pages do not retire gpt-5.4, whose flagships
# are now gpt-6-astra and gpt-6.1-sol). Moving a default is a cost decision, see REVIEW.md R-028.
NETWORK_ASSESSMENT_ANTHROPIC_MODEL=
NETWORK_ASSESSMENT_OPENAI_MODEL=

# =============================================================================
# AWS BEDROCK (saas engine on AWS)
# =============================================================================
# Injected by whoever deploys the images. The inference profile ARN takes
# precedence over the bare model id when both are set.
NETWORK_ASSESSMENT_BEDROCK_MODEL_ID=                     # e.g. anthropic.claude-opus-5-5 (Bedrock id format, checked 2026-10-25)
NETWORK_ASSESSMENT_BEDROCK_INFERENCE_PROFILE_ARN=

# =============================================================================
# AZURE KEY VAULT
# =============================================================================
# Used by: KeyVaultCredentialProvider (contractor workflow, network_assessment/core/auth.py)
# Provisioned by whoever deploys the images (Terraform or another tool) (identity module).
# Only required when storing secrets in Key Vault instead of .env (recommended for prod).
# Key Vault secrets written by whoever deploys the images:
#   cna-applicationinsights-connection-string
AZURE_KEY_VAULT_URL=                      # e.g. https://cna-dev-scus-kv.vault.azure.net/

# =============================================================================
# AZURE MONITORING
# =============================================================================
# Connection string injected by the deployment at runtime via Container App env vars.
# Set here for local dev only — in prod, pulled from Key Vault:
#   secret name: cna-applicationinsights-connection-string
APPLICATIONINSIGHTS_CONNECTION_STRING=    # InstrumentationKey=...;IngestionEndpoint=...

# =============================================================================
# WEB PLATFORM (network-assessment-web / Next.js 15)
# =============================================================================
# These are needed locally. In Azure, they are set via Container App secrets
# and env vars managed by whoever deploys the images.
# See apps/network-assessment-web/.env.example for the full web app reference.
DATABASE_URL=postgresql://cnaadmin:devpassword@localhost:5432/cna?sslmode=disable
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=your-entra-client-secret-here
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000

# =============================================================================
# CONTAINER REGISTRY
# =============================================================================
# CNA images are published to ONE public Docker Hub repository, <namespace>/img-ne-appliance-app, via 200-build-images.yml (its IMAGE_REPOSITORY).
# No ACR is provisioned for the current beta path.
# Container Apps pull from Docker Hub using registry credentials managed by whoever deploys the images.
# Use a Docker Hub access token, not the account password.
# For local docker testing only:
DOCKER_IMAGE_API=docker.io/hybridcloudworks/img-ne-appliance-app:api-latest
DOCKER_IMAGE_WORKER=docker.io/hybridcloudworks/img-ne-appliance-app:worker-latest
DOCKER_IMAGE_WEB=docker.io/hybridcloudworks/img-ne-appliance-app:web-latest
# The core's own publishing variables (GitHub Settings → Secrets and variables → Variables of THIS
# repository; never set in .env): DOCKERHUB_NAMESPACE, DOCKERHUB_CONNECTION (the Docker Hub OIDC
# connection id) and DOCKERHUB_ENABLED (true switches publishing on).

# =============================================================================
# IMAGE UPDATE CHECK (web tier — Admin → Updates)
# =============================================================================
# Each deployment compares the build it runs with the newest build the
# registry carries under the same floating tag (web-latest), using the pull-only
# registry credential it already has. Nothing updates itself: whoever deploys the
# images decides when to roll out a newer digest.
# NETWORK_ASSESSMENT_BUILD_SHA is baked into every image by 200-build-images (never set by hand).
NETWORK_ASSESSMENT_WEB_IMAGE=                            # Set by the deployment: the web image reference it deployed (docker.io/<ns>/img-ne-appliance-app:web-sha-<7>@sha256:<digest>; tag+digest)
NETWORK_ASSESSMENT_IMAGE_REGISTRY_USERNAME=              # Set by the deployment: registry pull username (same as the pull credential)
NETWORK_ASSESSMENT_IMAGE_REGISTRY_TOKEN=                 # Set by the deployment (container secret): registry pull token, read-only
NETWORK_ASSESSMENT_IMAGE_UPDATE_CHECK_INTERVAL_MINUTES=60  # Cache interval for the registry check; 0 switches the check off

# =============================================================================
# AWS DISCOVERY
# =============================================================================
# Used by: network-assessment discover aws, network-assessment analyze --aws
# Auth method: STS AssumeRole via org management account (DD-006)
# For CI/CD: use OIDC (no keys). The static keys below are LOCAL DEVELOPMENT ONLY; prefer aws sso login.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=                        # LOCAL DEVELOPMENT ONLY. Leave blank for SSO or instance profile
AWS_SECRET_ACCESS_KEY=                    # LOCAL DEVELOPMENT ONLY. Never commit or deploy; leave blank for SSO or instance profile
AWS_SESSION_TOKEN=                        # LOCAL DEVELOPMENT ONLY. Leave blank unless using temporary credentials
AWS_VENDOR_ACCOUNT_ID=                    # Your management/vendor account ID

# =============================================================================
# AWS DELIVERY PORTAL
# =============================================================================
# Used by: network-assessment publish --cloud aws
# Auth: OIDC in CI. Local: IAM credentials above.
NETWORK_ASSESSMENT_PUBLISH_BUCKET=                       # S3 bucket name (e.g. cna-deliverables-prod)

# =============================================================================
# MCP SERVERS (OPTIONAL — Phase D AI enrichment)
# =============================================================================
# If unset, offline recommendations are used (DD-003 fallback).
NETWORK_ASSESSMENT_MCP_SERVER_URL=none                   # default MCP server (fallback when cloud-specific URLs not set)
AWS_MCP_SERVER_URL=                       # awslabs/mcp endpoint if self-hosted
AZURE_MCP_SERVER_URL=                     # Azure MCP server endpoint if self-hosted
NETWORK_ASSESSMENT_AZURE_MCP_ENDPOINT=                   # https://mcp.azure.com — set when auth is wired; leave empty for offline fallback
NETWORK_ASSESSMENT_AZURE_MCP_TRANSPORT=streamable-http
NETWORK_ASSESSMENT_AWS_MCP_ENDPOINT=                    # https://aws-mcp.us-east-1.api.aws/mcp — set when auth is wired; leave empty for offline fallback
NETWORK_ASSESSMENT_AWS_MCP_TRANSPORT=streamable-http
NETWORK_ASSESSMENT_DRAWIO_MCP_URL=http://localhost:3000/api/drawio-mcp      # draw.io MCP endpoint exposed by the app/deployment

# Foundry recommendation agent (OPTIONAL — portal-configured MCP tools + instructions).
# When BOTH are set, recommendation enrichment routes through the Foundry agent
# (which calls its MCP tools server-side) before falling back to the direct MCP
# clients and then the offline library. Auth is managed identity (Cognitive Services User).
FOUNDRY_PROJECT_ENDPOINT=                 # Azure AI Foundry project endpoint
FOUNDRY_RECOMMENDATION_AGENT_ID=          # portal-created agent id (e.g. asst_...)

# =============================================================================
# NOTIFICATIONS (OPTIONAL)
# =============================================================================
TEAMS_WEBHOOK_URL=                        # MS Teams channel webhook for CRITICAL alerts (DD-016)
NOTIFICATION_EMAIL_FROM=assessments@yourorg.com

# =============================================================================
# PLATFORM
# =============================================================================
NETWORK_ASSESSMENT_VERSION=1.0.0
NETWORK_ASSESSMENT_LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
NETWORK_ASSESSMENT_DATA_DIR=./engagements                # Where engagement folders are written
NETWORK_ASSESSMENT_SKIP_RASTER=false                     # true = skip PNG/PDF diagram export (faster local dev)
NETWORK_ASSESSMENT_DIAGRAM_DPI=150                       # PNG export DPI (configurable per Gap 11 fix)
NETWORK_ASSESSMENT_DIAGRAM_MAX_PX=4096                   # Max PNG dimension cap in pixels

# =============================================================================
# ADDITIONAL SETTINGS THE CODE READS (inventory completed for ticket NE-7)
# =============================================================================
# Each name below is read with os.environ / os.getenv / process.env in the code.
# Defaults shown are the ones in the code. Nothing here carries a secret value.

# Web tier (apps/network-assessment-web). NETWORK_ASSESSMENT_API_INTERNAL_URL has no default: without it the chat, report,
# diagram and discovery actions answer "not configured". Its local value is in apps/network-assessment-web/.env.example.
NETWORK_ASSESSMENT_API_INTERNAL_URL=                     # Private base URL of network-assessment-api, e.g. http://localhost:8000 locally; set by the deployment in Azure
# NODE_ENV                                # Set to production by the web Dockerfile; Next.js sets development locally. Do not set by hand in deployments
# AWS_REGION                              # Optional. AWS SDK region; the web AI Engine page shows it, falls back to AWS_DEFAULT_REGION, then "SDK default"

# Encryption key for the stored BYO AI keys (web always; api in byo-api mode). SECRET: base64, exactly
# 32 bytes. Deliberately NO value here: the deployment injects it from the cloud vault.
# CREDENTIAL_ENCRYPTION_KEY

# Optional local administrator for the web tier (apps/network-assessment-web/prisma/seed-local-admin.js, run by migrate.sh).
# A PBKDF2 hash string, never the plaintext password. Unset means the seed is skipped. Deliberately NO value here.
# LOCAL_ADMIN_PASSWORD

# AWS role assumption (network-assessment discover aws, AWSCredentials.from_env in network_assessment/core/auth.py)
NETWORK_ASSESSMENT_AWS_ROLE_ARN=                         # Required for network-assessment discover aws unless --role is passed; ARN of the role to assume
NETWORK_ASSESSMENT_AWS_EXTERNAL_ID=                      # Optional. External ID presented when assuming that role; default empty

# Worker blob upload (apps/network-assessment-worker/main.py)
NETWORK_ASSESSMENT_BLOB_UPLOAD_ENABLED=false             # true switches the Azure Blob upload on; default false (upload is skipped)
NETWORK_ASSESSMENT_BLOB_UPLOAD_MODE=sdk                  # Label echoed in the upload result; default sdk. It does not change behaviour today
NETWORK_ASSESSMENT_STORAGE_ACCOUNT_NAME=                 # Storage account for the upload; required when NETWORK_ASSESSMENT_BLOB_UPLOAD_ENABLED=true (otherwise the result is an error)
NETWORK_ASSESSMENT_STORAGE_STATIC_CONTAINER=static-site  # Blob container for the published static site; default static-site

# draw.io MCP client (network_assessment/ai_engine/mcp_client/drawio_mcp_client.py)
NETWORK_ASSESSMENT_DRAWIO_MCP_TIMEOUT=5                  # Seconds to wait for the draw.io MCP endpoint; default 5

# Build-time only, not a runtime setting: NETWORK_ASSESSMENT_BUILD_SHA is baked into every image by
# 200-build-images.yml (Dockerfile ARG/ENV) and is never injected or set by hand.
# NETWORK_ASSESSMENT_BUILD_SHA
